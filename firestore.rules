rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Content settings: Public read, public write (for admin portal updates in this applet)
    match /content/{document} {
      allow read, write: if true;
    }

    // Services collection: Public read, public write
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // Products collection: Public read, public write
    match /products/{productId} {
      allow read, write: if true;
    }

    // Gallery collection: Public read, public write
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Bookings collection: Public read & create & delete
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
  }
}
